// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String      @id
  email      String?      @unique
  password   String?
  // workspaces Workspace[]
}

model Workspace {
  id        Int      @id @default(autoincrement())
  name      String

  // userId    Int
  // user      User     @relation(fields: [userId], references: [id])

  // todos     Todo[]
}

model Todo {
  id          Int         @id @default(autoincrement())
  status      TodoStatus
  todo        String

  // workspaceId Int
  // workspace   Workspace   @relation(fields: [workspaceId], references: [id])
}

model TimeManagement {
  id          String         @id
  text        String
  data        String
  completedAt Boolean     @default(false)
  createdAt   DateTime    @default(now())

  // workspaceId Int
  // workspace   Workspace   @relation(fields: [workspaceId], references: [id])
}

model Project {
  id          Int         @id @default(autoincrement())
  projectName String
  deadline    DateTime
  progress    Int         @default(0)
  createdAt   DateTime    @default(now())

  // workspaceId Int
  // workspace   Workspace   @relation(fields: [workspaceId], references: [id])
}

model Note {
  id          Int         @id @default(autoincrement())
  title       String
  notes       String
  calander    DateTime
  createdAt   DateTime    @default(now())

  // workspaceId Int
  // workspace   Workspace   @relation(fields: [workspaceId], references: [id])
}

model Goal {
  id          Int         @id @default(autoincrement())
  goal        String
  deadline    String
  progress    Int         @default(0)
  createdAt   DateTime    @default(now())

  // workspaceId Int
  // workspace   Workspace   @relation(fields: [workspaceId], references: [id])
}

model Planner {
  id          Int         @id @default(autoincrement())
  task        String
  prioirity   String
  categories  String        
  deadline    DateTime
  date        DateTime
  createdAt   DateTime    @default(now())

  // workspaceId Int
  // workspace   Workspace   @relation(fields: [workspaceId], references: [id])
}

enum TodoStatus {
  pending
  completed
}